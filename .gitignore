# Databricks bundle state, local environments, caches, build output
.databricks/
.venv/
__pycache__/
*.pyc
.pytest_cache/
build/
*.egg-info/

# Secrets and local config: never commit
.env
.env.*
*.tfstate
*.tfstate.*
.terraform/
gitleaks*.json

# Session transcripts (contain prompts and notes; not reviewed for publishing)
SESSION_LOG*.md
SESSION_LOG*.docx
prompts.pdf

# Baseline artifacts (see baseline/README.md).
# Committed: reports, configs, scripts, manifests, classifications and the metric snapshots
# WITHOUT row_state (synthetic data).
# Ignored: raw row dumps, and files that carry environment identifiers (workspace host,
# emails, run-page URLs, object ids).
baseline/raw/
baseline/run_*_job.json
baseline/run_*_job.err
baseline/**/*.log
baseline/**/*.err
baseline/**/*.jsonl
baseline/v2/dev_resources.txt
